        public static IReadOnlyList<pokemonProperties> GetAll() => _all.AsReadOnly();

        public static pokemonProperties? GetByNumber(int number) =>
            _all.FirstOrDefault(p => p.PokedexNumber == number);

        public static pokemonProperties? GetByName(string name) =>
            _all.FirstOrDefault(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

// Devuelve <paramref name="count"/> pokémon distintos de forma aleatoria.

        public static List<pokemonProperties> GetRandomTeam(int count = 3)
        {
            if (count < 1 || count > 3) throw new ArgumentOutOfRangeException(nameof(count), "El equipo debe tener entre 1 y 3 Pokémon.");
            var rng = new Random();
            return _all.OrderBy(_ => rng.Next()).Take(count).ToList();
        }

// busqueda por tipo 
        public static List<pokemonProperties> GetByType(string type) =>
            _all.Where(p => p.Types.Contains(type, StringComparer.OrdinalIgnoreCase)).ToList();
