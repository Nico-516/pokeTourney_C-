using pokeTourney.Model.Interfaces;

namespace pokeTourney.Model.Pokemon
{
// Atributos de combate de un Pokémon
    
    public class pokemonProperties : IMakeNoise
    {
        public int            pokedexNumber{ get; set; }
        public string         name{ get; set; }
        public List<string>   types{ get; set; } = new();
        public int            attackPoints{ get; set; }
        public int            defencePoints{ get; set; }
        public int            speedPoints{ get; set; }
        public int            healthPoints{ get; set; }
        public int            sizeInCm{ get; set; }
        public int            weightInGrams{ get; set; }
        public List<string>   attacks{ get; set; } = new();

        public pokemonProperties(
            int    pokedexNumber,
            string name,
            int    attackPoints,
            int    defencePoints,
            int    speedPoints,
            int    healthPoints,
            int    sizeInCm,
            int    weightInGrams,
            List<string> types,
            List<string> attacks)
        {
            PokedexNumber = pokedexNumber;
            Name          = name;
            AttackPoints  = attackPoints;
            DefencePoints = defencePoints;
            SpeedPoints   = speedPoints;
            HealthPoints  = healthPoints;
            SizeInCm      = sizeInCm;
            WeightInGrams = weightInGrams;
            Types         = types;
            Attacks       = attacks;
        }

        public string MakeNoise() => $"{Name}! {Name}!";

        public override string ToString() =>
            $"#{PokedexNumber:000} {Name} [{string.Join("/", Types)}] " +
            $"HP:{HealthPoints} ATK:{AttackPoints} DEF:{DefencePoints} SPD:{SpeedPoints}";
    }
}
